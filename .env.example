# PostgreSQL (used by Docker Compose)
POSTGRES_DB=agentic_commerce_support
POSTGRES_USER=agentic_commerce
POSTGRES_PASSWORD=change-me

# API database connection. For the Compose database running on the host:
DATABASE_URL=postgresql+psycopg://agentic_commerce:change-me@localhost:5433/agentic_commerce_support

# Reserved for the future AI workflow. Not required for the current foundation.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# URL exposed to the browser for future API integration.
NEXT_PUBLIC_API_URL=http://localhost:8000

